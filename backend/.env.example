# Backend Environment Variables - EXAMPLE FILE (safe to commit)
# Copy this file to .env and fill in your values

# Server port (Railway sets this automatically)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Frontend URL for CORS (allow frontend to call this backend)
# Local: http://localhost:5173
# Railway: https://your-frontend-service.up.railway.app
FRONTEND_URL=http://localhost:5173
